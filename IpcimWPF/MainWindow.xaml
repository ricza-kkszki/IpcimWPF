<Window x:Class="IpcimWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IpcimWPF"
        mc:Ignorable="d"
        Title="IpcimWPF" Height="300" Width="500">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <DataGrid x:Name="dataGrid" AutoGenerateColumns="True" Grid.Column="0" Margin="10"/>
        <StackPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10">
            <Label Content="Domain-Neve:" Margin="5"/>
            <TextBox x:Name="domainNameTextBox" Width="200" Margin="5"/>
            <Label Content="IP cím:"/>
            <TextBox x:Name="ipTextBox" Width="200" Margin="5"/>
            <Button Content="Bevitel" Click="bevitel" HorizontalAlignment="Left" Width="100" Margin="5"/>
            <Button Content="Mentés" HorizontalAlignment="Left" Width="100" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
